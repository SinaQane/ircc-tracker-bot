# IRCC credentials (used by Cognito)
UCI=your_uci_here
AUTH_PASSWORD=your_password_here

# Relay endpoint (must be reachable from inside Iran)
TG_RELAY_URL=https://your-relay.example.com/
TG_RELAY_SECRET=your-long-random-secret-here  # must match the relay's HOOK_SECRET

# Polling interval in minutes
POLL_INTERVAL_MINUTES=5
