# Shared secret the checker must send in the X-Hook-Secret header.
HOOK_SECRET=your-long-random-secret-here

# Telegram bot credentials
TELEGRAM_BOT_TOKEN=123456789:AA...your_bot_token...
# User or group chat ID (groups are often negative, e.g. -1001234567890)
TELEGRAM_CHAT_ID=123456789

# Optional: enable formatting. Allowed: Markdown, MarkdownV2, HTML
TELEGRAM_PARSE_MODE=Markdown

# Optional: override port if your platform needs it (Railway sets PORT)
PORT=8000
